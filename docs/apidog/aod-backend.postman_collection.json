{
	"info": {
		"_postman_id": "b1e2b3a4-5c6d-4e7f-8a9b-0c1d2e3f4a5b",
		"name": "AOD Backend",
		"description": "Auth, profile, and team endpoints for the AOD backend. Import the accompanying environment file too — run Login or Register once and the `token` variable fills itself in for every other request. Team endpoints act on the caller's own active team automatically; the `team_id` variable is only needed if you want to override that via `?team=`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{ "key": "token", "value": "{{token}}", "type": "string" }
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body && body.data) {",
									"    if (body.data.token) pm.environment.set('token', body.data.token);",
									"    if (body.data.user && body.data.user.id) pm.environment.set('user_id', body.data.user.id);",
									"    if (body.data.team && body.data.team.id) pm.environment.set('team_id', body.data.team.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"player-one\",\n    \"email\": \"player-one@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"role\": \"Player\",\n    \"riot_id\": \"PlayerOne#APAC\",\n    \"team_code\": \"\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/register",
							"host": [ "{{base_url}}" ],
							"path": [ "register" ]
						},
						"description": "role: Coach | Player. Coach may send team_action=create with team_name (and optional description) to create a team, or team_code to request joining one, or neither to register teamless. Player may send team_code to request joining, or omit it to register teamless. riot_id is required for Player and prohibited for Coach."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body && body.data) {",
									"    if (body.data.token) pm.environment.set('token', body.data.token);",
									"    if (body.data.user && body.data.user.id) pm.environment.set('user_id', body.data.user.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"player-one@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [ "{{base_url}}" ],
							"path": [ "login" ]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [ "{{base_url}}" ],
							"path": [ "logout" ]
						}
					}
				}
			]
		},
		{
			"name": "Profile",
			"item": [
				{
					"name": "Get Authenticated User",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/user",
							"host": [ "{{base_url}}" ],
							"path": [ "user" ]
						}
					}
				},
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/me",
							"host": [ "{{base_url}}" ],
							"path": [ "me" ]
						}
					}
				},
				{
					"name": "Update My Profile",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"player-one\",\n    \"email\": \"player-one@example.com\",\n    \"riot_id\": \"PlayerOne#APAC\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/me",
							"host": [ "{{base_url}}" ],
							"path": [ "me" ]
						}
					}
				},
				{
					"name": "Update My Password",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"current_password\": \"password123\",\n    \"password\": \"newpassword123\",\n    \"password_confirmation\": \"newpassword123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/me/password",
							"host": [ "{{base_url}}" ],
							"path": [ "me", "password" ]
						}
					}
				},
				{
					"name": "Get My Teams",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/me/teams",
							"host": [ "{{base_url}}" ],
							"path": [ "me", "teams" ]
						}
					}
				}
			]
		},
		{
			"name": "Teams",
			"item": [
				{
					"name": "Request to Join Team",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"if (body && body.data && body.data.team && body.data.team.id) {",
									"    pm.environment.set('team_id', body.data.team.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"team_code\": \"TM-XXXXXXXX\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/teams/join",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "join" ]
						}
					}
				},
				{
					"name": "Get Team",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/teams?team={{team_id}}",
							"host": [ "{{base_url}}" ],
							"path": [ "teams" ],
							"query": [
								{ "key": "team", "value": "{{team_id}}", "disabled": true, "description": "Optional. Omit to use your own active team automatically." }
							]
						},
						"description": "Returns the team plus its active members (data.team.members) and the team_code, both shown to any active member regardless of role. Resolves to your own active team automatically — the ?team= query param is disabled by default; enable it only to look up a different team."
					}
				},
				{
					"name": "Update Team",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"team_name\": \"Aces of Dawn\",\n    \"description\": \"A private VALORANT team.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/teams",
							"host": [ "{{base_url}}" ],
							"path": [ "teams" ]
						},
						"description": "Main coach only. Acts on your own active team; append ?team={id} to target a different one."
					}
				},
				{
					"name": "Remove Member",
					"request": {
						"method": "DELETE",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/teams/members/{{target_user_id}}",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "members", "{{target_user_id}}" ]
						}
					}
				},
				{
					"name": "Leave Team",
					"request": {
						"method": "POST",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/teams/leave",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "leave" ]
						}
					}
				},
				{
					"name": "Get Join Requests",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/teams/join-requests",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "join-requests" ]
						}
					}
				},
				{
					"name": "Decide Join Request",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"approve\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/teams/join-requests/{{target_user_id}}",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "join-requests", "{{target_user_id}}" ]
						}
					}
				},
				{
					"name": "Get Team Settings",
					"request": {
						"method": "GET",
						"header": [ { "key": "Accept", "value": "application/json" } ],
						"url": {
							"raw": "{{base_url}}/teams/settings",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "settings" ],
							"query": [
								{ "key": "team", "value": "{{team_id}}", "disabled": true, "description": "Optional. Omit to use your own active team automatically." }
							]
						},
						"description": "Detection settings for the team: dead_air_threshold_ms plus the informative_keywords and declarative_keywords lists. Any active Coach (main or assistant); non-coach members get 403, non-members 404."
					}
				},
				{
					"name": "Update Team Keywords",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"informative_keywords\": [\"planted\", \"defused\", \"one\", \"two\"],\n    \"declarative_keywords\": [\"flashing\", \"smoking\", \"rotating\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/teams/settings/keywords",
							"host": [ "{{base_url}}" ],
							"path": [ "teams", "settings", "keywords" ],
							"query": [
								{ "key": "team", "value": "{{team_id}}", "disabled": true, "description": "Optional. Omit to use your own active team automatically." }
							]
						},
						"description": "Replaces the detection keyword list. Send the COMPLETE desired list per category (same shape as GET /teams/settings) — both keys required; the server inserts new words and deletes any word you omit. Single words only (no spaces), 1-64 chars, max 200 per category; matching is case-insensitive and a word may not appear in both categories. Any active Coach; non-coach 403, non-member 404. Returns the full settings body."
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000/api" }
	]
}
